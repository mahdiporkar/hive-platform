model
  schema 1.1

# Subjects
type user

type group
  relations
    define member: [user]

type role
  relations
    define assignee: [user, group#member]

# Platform administration (control plane). Business roles never receive these relations implicitly.
type platform
  relations
    define super_admin: [user, group#member, role#assignee]
    define operator: [user, group#member, role#assignee] or super_admin
    define security_admin: [user, group#member, role#assignee] or super_admin
    define integration_admin: [user, group#member, role#assignee] or super_admin
    define auditor: [user, group#member, role#assignee] or super_admin
    define reader: operator or security_admin or integration_admin or auditor

# Resource catalog node. Management is inherited down the resource tree.
type resource
  relations
    define parent: [resource]
    define manager: [user, group#member, role#assignee] or manager from parent

# One object per declared resource action, so solutions may declare arbitrary action keys.
type action
  relations
    define resource: [resource]
    define grantee: [user, group#member, role#assignee]
    define allowed: grantee or manager from resource
