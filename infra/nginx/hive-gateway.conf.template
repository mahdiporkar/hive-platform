# Hive gateway (default-shell image): static shell, console under /console/, Hive APIs to the BFF.
# One browser origin keeps the session cookie first-party; the BFF never needs CORS.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
  listen 8080;
  server_tokens off;
  client_max_body_size 10m;
  root /usr/share/nginx/html;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  # Micro-apps are evaluated from verified Blob URLs (SRI), hence blob: in script-src; styles may be inline (shadow roots).
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;

  location ~ ^/(api|auth|oauth2|login/oauth2)/ {
    proxy_pass ${HIVE_BFF_UPSTREAM};
    proxy_set_header Host $http_host;
    # X-Forwarded-Proto/Host/Port from an outer TLS terminator pass through unchanged; Host carries the public origin.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_http_version 1.1;
    proxy_read_timeout 130s;
  }
  location = /actuator/health/readiness { proxy_pass ${HIVE_BFF_UPSTREAM}; }
  location /actuator/ { return 404; }
  location /console/ { proxy_pass ${HIVE_CONSOLE_UPSTREAM}; proxy_set_header Host $http_host; }
  location /modules/ { alias /srv/hive/modules/; try_files $uri =404; add_header Cache-Control "no-cache"; }
  location = /shell-extensions.js { alias /srv/hive/shell-extensions.js; try_files "" =404; }
  location / { try_files $uri /index.html; }
}
